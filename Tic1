import java.util.Scanner;

public class TicTacToe {

    static char[][] board = new char[3][3];

    static void initializeBoard() {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                board[i][j] = ' ';
            }
        }
    }

    static void printBoard() {
        for (int i = 0; i < 3; i++) {
            System.out.println(
                    board[i][0] + " | " +
                    board[i][1] + " | " +
                    board[i][2]
            );

            if (i < 2) {
                System.out.println("--+---+--");
            }
        }
    }

    static boolean hasWon(char p) {

        for (int i = 0; i < 3; i++) {

            if (board[i][0] == p &&
                board[i][1] == p &&
                board[i][2] == p) {
                return true;
            }

            if (board[0][i] == p &&
                board[1][i] == p &&
                board[2][i] == p) {
                return true;
            }
        }

        return (board[0][0] == p &&
                board[1][1] == p &&
                board[2][2] == p)
                ||
                (board[0][2] == p &&
                board[1][1] == p &&
                board[2][0] == p);
    }

    static boolean isFull() {

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {

                if (board[i][j] == ' ') {
                    return false;
                }
            }
        }

        return true;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        initializeBoard();

        char currentPlayer = 'X';

        while (true) {

            System.out.print(
                    "Player " + currentPlayer +
                    ", enter row and column (0-2): "
            );

            int row = sc.nextInt();
            int column = sc.nextInt();

            if (row < 0 || row > 2 ||
                column < 0 || column > 2) {

                System.out.println(
                        "Invalid position! Enter values between 0 and 2."
                );

                continue;
            }

            if (board[row][column] != ' ') {

                System.out.println(
                        "Position already occupied! Try again."
                );

                continue;
            }

            board[row][column] = currentPlayer;

            printBoard();

            if (hasWon(currentPlayer)) {

                System.out.println(
                        "Player " + currentPlayer + " wins!"
                );

                break;
            }

            if (isFull()) {

                System.out.println("It's a tie!");

                break;
            }

            if (currentPlayer == 'X') {
                currentPlayer = 'O';
            } else {
                currentPlayer = 'X';
            }

            System.out.println();
        }

        sc.close();
    }
}
